---
import Base from '../../layouts/Base.astro';
import PostRow from '../../components/PostRow.astro';
import {getPosts} from '../../lib/posts';
const posts = await getPosts();
const categories = [...new Set(posts.map(p=>p.data.category))];
---
<Base title="Writing — Clement"><section class="page-intro"><p class="eyebrow">THE NOTEBOOK</p><h1>Thinking out loud.<br/><em>Writing it down.</em></h1><p>Explanations, experiments, and working notes on code and systems.</p></section>
<div class="archive-controls"><label class="search-label"><span>Search notes</span><input id="search" type="search" placeholder="Search a topic, title, or tag…" /></label><div class="filters" aria-label="Filter notes"><button data-filter="All" aria-pressed="true">All notes</button>{categories.map(c=><button data-filter={c} aria-pressed="false">{c}</button>)}</div></div>
<p class="archive-count" id="result-count" role="status">{posts.length} notes · example technical writing</p>
<div class="archive-list">{posts.map((post,index)=><div data-post data-category={post.data.category} data-search={`${post.data.title} ${post.data.description} ${post.data.tags.join(' ')}`.toLowerCase()}><PostRow post={post} index={index}/></div>)}</div><p id="empty" hidden>No notes match yet. Try another topic or select all notes.</p>
<script>
let active = 'All';
const search = document.querySelector<HTMLInputElement>('#search')!;
function filter(){let count=0;document.querySelectorAll<HTMLElement>('[data-post]').forEach(row=>{row.hidden = !( (active==='All'||row.dataset.category===active) && row.dataset.search?.includes(search.value.toLowerCase().trim()));if(!row.hidden) count++;});document.querySelector('#result-count')!.textContent=`${count} ${count===1?'note':'notes'} · example technical writing`;document.querySelector<HTMLElement>('#empty')!.hidden=count>0;}
search.addEventListener('input',filter);
document.querySelectorAll<HTMLButtonElement>('[data-filter]').forEach(button=>button.addEventListener('click',()=>{active=button.dataset.filter!;document.querySelectorAll('[data-filter]').forEach(b=>b.setAttribute('aria-pressed',String(b===button)));filter();}));
</script></Base>
