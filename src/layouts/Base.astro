---
import '../styles/global.css';
import '@fontsource-variable/manrope';
import '@fontsource-variable/newsreader';
import '@fontsource/ibm-plex-mono/400.css';
import 'katex/dist/katex.min.css';
interface Props { title?: string; description?: string; }
const { title = 'Clement — a working notebook', description = 'Notes on code, systems, and the ideas underneath. A technical notebook and project portfolio by Clement.' } = Astro.props;
const pathname = Astro.url.pathname;
const canonical = new URL(pathname, Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title><meta name="description" content={description} />
    <link rel="canonical" href={canonical} /><link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content={title} /><meta property="og:description" content={description} />
    <meta property="og:type" content="website" /><meta property="og:url" content={canonical} />
    <meta name="theme-color" content="#f7f6f2" />
    <link rel="alternate" type="application/rss+xml" title="Clement's notebook" href="/rss.xml" />
    <script is:inline>
      try { const t = localStorage.getItem('theme'); if (t === 'dark' || (!t && matchMedia('(prefers-color-scheme: dark)').matches)) document.documentElement.dataset.theme = 'dark'; } catch {}
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="shell">
      <header class="site-header">
        <a href="/" class="wordmark" aria-label="Clement home"><span class="mark">c<span>·</span></span>Clement<span class="wordmark-dot">.</span></a>
        <nav aria-label="Main navigation">
          <a href="/" aria-current={pathname === '/' ? 'page' : undefined}>Overview</a>
          <a href="/writing/" aria-current={pathname.startsWith('/writing') ? 'page' : undefined}>Writing</a>
          <a href="/projects/" aria-current={pathname.startsWith('/projects') ? 'page' : undefined}>Projects</a>
          <a href="/about/" aria-current={pathname === '/about/' ? 'page' : undefined}>About</a>
        </nav>
        <button id="theme-toggle" class="theme-toggle" aria-label="Switch to dark theme" title="Change color theme"><span aria-hidden="true">◐</span></button>
      </header>
      <main id="main"><slot /></main>
      <footer class="site-footer"><div><a href="/" class="footer-name">Clement.</a><span>A notebook, always in progress.</span></div><div class="footer-links"><a href="https://github.com/poytaytoy">GitHub ↗</a><a href="/rss.xml">RSS ↗</a><a href="/about/">Colophon</a></div><span class="copyright">© {new Date().getFullYear()} Clement</span></footer>
    </div>
    <script>
      const toggle = document.querySelector<HTMLButtonElement>('#theme-toggle');
      const update = () => toggle?.setAttribute('aria-label', `Switch to ${document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark'} theme`);
      update();
      toggle?.addEventListener('click', () => {
        const theme = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = theme;
        try { localStorage.setItem('theme', theme); } catch {}
        update();
      });
    </script>
  </body>
</html>
